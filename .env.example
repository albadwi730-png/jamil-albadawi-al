# Public browser configuration only. Never put service-role keys or provider secrets here.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# Configure server-side secrets only in your backend/deployment secret manager:
# SUPABASE_SERVICE_ROLE_KEY=
# OPENAI_API_KEY=
# ELEVENLABS_API_KEY=
# STORAGE_S3_ENDPOINT=
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=
